APP_NAME=infracciones-api
NODE_ENV=development
NODE_OPTIONS=--max-old-space-size=512
PORT=3000

DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=infracciones_user
DB_PASSWORD=change_me_local_db_password
DB_DATABASE=control_infracciones_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_QUERY_EXECUTION_TIME=500
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
API_MAX_PAGE_SIZE=100
HEAVY_REQUEST_CONCURRENCY=2
CACHE_QUERY_ENABLED=false
CACHE_QUERY_DURATION_MS=30000

# Concurrencia de escrituras
# Las mutaciones criticas del mismo expediente se serializan con advisory locks de PostgreSQL.
CONCURRENCY_LOCK_TIMEOUT_MS=5000
CONCURRENCY_LOCK_RETRY_MS=50

# Importacion Excel
# La funcionalidad sigue deshabilitada por defecto.
ENABLE_EXCEL_IMPORT=false
# Maximo de filas de datos leidas de la hoja INFRACCIONES.
EXCEL_IMPORT_MAX_ROWS=50000
# Limites del contenedor ZIP de un XLSX, aplicados antes de descomprimirlo.
EXCEL_IMPORT_MAX_ZIP_ENTRIES=2048
EXCEL_IMPORT_MAX_UNCOMPRESSED_BYTES=134217728
EXCEL_IMPORT_MAX_ENTRY_BYTES=100663296
EXCEL_IMPORT_MAX_COMPRESSION_RATIO=250

# Perimetro / proxy inverso
# En desarrollo/local dejalo vacio para que Express no confie en proxies y use trust proxy = false.
# En produccion es obligatorio: usa la IP o CIDR exacta del proxy Nginx/Docker que llega al backend.
# No uses true, *, 0.0.0.0/0, ::/0 ni un numero de saltos.
TRUST_PROXY=

# Auth / sesiones
JWT_SECRET=change_me_strong_jwt_secret_min_32_chars
CSRF_SECRET=change_me_strong_csrf_secret_min_32_chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Usuario inicial / seed
# Se usa por backend/infracciones-api/src/database/seeds/seed-admin-user.ts
# ADMIN_PASSWORD es obligatorio y debe tener entre 15 y 128 caracteres.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password_min_15_chars
ADMIN_NOMBRE=Administrador
ADMIN_ROL=ADMIN
