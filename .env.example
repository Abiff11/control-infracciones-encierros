# Archivo ejemplo para /opt/intranet/apps/control-infracciones-encierros/.env
# No subir .env real ni secretos al repositorio.
# Los secretos de base de datos viven fuera del repo en:
# /opt/intranet/infra/security/control_infracciones.db.env

# Runtime
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=512
APP_NAME=control_infracciones_encierros
PORT=3104
ENABLE_SWAGGER=false

# Frontend servido detras de Nginx central y Cloudflare Access
VITE_APP_NAME=control-infracciones-encierros
VITE_BASE_PATH=/
VITE_API_URL=/api
VITE_SOCKET_URL=/
VITE_SOCKET_PATH=/socket.io

# CORS / origenes permitidos
FRONTEND_ORIGINS=https://infracciones.sisoaxaca.com
CORS_ORIGIN=https://infracciones.sisoaxaca.com

# PostgreSQL central
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=control_infracciones_user
DB_DATABASE=control_infracciones_db
# DB_PASSWORD debe definirse en /opt/intranet/infra/security/control_infracciones.db.env
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_QUERY_EXECUTION_TIME=500
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000

# PostgreSQL connection pool
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# API workload limits
API_MAX_PAGE_SIZE=100
HEAVY_REQUEST_CONCURRENCY=2

# TypeORM query cache. Keep disabled by default for sensitive data.
CACHE_QUERY_ENABLED=false
CACHE_QUERY_DURATION_MS=30000

# Auth / sesiones
# JWT_SECRET y CSRF_SECRET reales deben definirse solo en .env del servidor.
# Deben tener minimo 32 caracteres y ser distintos entre si.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_MINUTES=60
REFRESH_COOKIE_MODE=session
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# CSRF_SECRET=define_un_valor_real_de_al_menos_32_caracteres

# Rate limiting / importaciones
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
ENABLE_EXCEL_IMPORT=false
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_READ_TTL_MS=60000
THROTTLE_READ_LIMIT=240
THROTTLE_WRITE_TTL_MS=60000
THROTTLE_WRITE_LIMIT=80
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=20
THROTTLE_REFRESH_TTL_MS=60000
THROTTLE_REFRESH_LIMIT=60
THROTTLE_REPORT_TTL_MS=60000
THROTTLE_REPORT_LIMIT=20
THROTTLE_IMPORT_TTL_MS=60000
THROTTLE_IMPORT_LIMIT=5
THROTTLE_UPLOAD_TTL_MS=60000
THROTTLE_UPLOAD_LIMIT=5
THROTTLE_SEARCH_TTL_MS=60000
THROTTLE_SEARCH_LIMIT=60
