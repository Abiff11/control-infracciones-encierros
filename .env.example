# Archivo ejemplo para /opt/intranet/apps/control-infracciones-encierros/.env
# No subir .env real ni secretos al repositorio.
# Los secretos de base de datos viven fuera del repo en:
# /opt/intranet/infra/security/control_infracciones.db.env

# Runtime
NODE_ENV=production
APP_NAME=control_infracciones_encierros
PORT=3104
ENABLE_SWAGGER=false

# Frontend servido detras de Nginx central y Cloudflare Access
VITE_APP_NAME=control-infracciones-encierros
VITE_BASE_PATH=/
VITE_API_URL=/api
VITE_SOCKET_URL=/
VITE_SOCKET_PATH=/socket.io

# CORS / origenes permitidos
FRONTEND_ORIGINS=https://infracciones.sisoaxaca.com
CORS_ORIGIN=https://infracciones.sisoaxaca.com

# PostgreSQL central
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=infracciones_user
DB_DATABASE=control_infracciones_db
# DB_PASSWORD debe definirse en /opt/intranet/infra/security/control_infracciones.db.env
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_QUERY_EXECUTION_TIME=500

# Auth
# JWT_SECRET real debe definirse solo en .env del servidor.
# Debe tener minimo 32 caracteres.
JWT_EXPIRES_IN=8h
