# Runtime
NODE_ENV=production
APP_NAME=control_infracciones_encierros
PORT=3104
ENABLE_SWAGGER=false

# Frontend
VITE_APP_NAME=control-infracciones-encierros
VITE_API_URL=/api

# CORS
FRONTEND_ORIGINS=https://infracciones.sisoaxaca.com,http://100.118.154.7
CORS_ORIGIN=https://infracciones.sisoaxaca.com

# Base de datos PostgreSQL central
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=infracciones_user
DB_DATABASE=control_infracciones_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_QUERY_EXECUTION_TIME=500

# Auth
JWT_EXPIRES_IN=8h

# IMPORTANTE:
# Definir DB_PASSWORD y JWT_SECRET reales únicamente en el servidor.
# No subir valores reales de secretos al repositorio.
