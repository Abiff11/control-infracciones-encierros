# PostgreSQL
POSTGRES_DB=control_infracciones_db
POSTGRES_USER=infracciones_user
POSTGRES_PASSWORD=change_me_strong_postgres_password_min_12_chars

# Docker
APP_VERSION=latest
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088

# Backend
NODE_ENV=production
PORT=3000
DB_HOST=postgres_infracciones
DB_PORT=5432
DB_USERNAME=infracciones_user
DB_PASSWORD=change_me_strong_db_password_min_12_chars
DB_DATABASE=control_infracciones_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_QUERY_EXECUTION_TIME=500
# JWT_SECRET y CSRF_SECRET deben ser reales, largos y distintos entre si.
JWT_SECRET=change_me_strong_jwt_secret_min_32_chars
CSRF_SECRET=change_me_strong_csrf_secret_min_32_chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://infracciones.example.gob.mx

# Frontend build
VITE_API_URL=/api
